NEXT_PUBLIC_SITE_URL=https://hzense.com
DATABASE_URL=postgresql://user:password@localhost:5432/hzense
DATABASE_DIRECT_URL=
HZENSE_DATABASE_EXPECTED_HOST=
HZENSE_DATABASE_EXPECTED_PORT=5432
HZENSE_DATABASE_EXPECTED_NAME=
HZENSE_DATABASE_EXPECTED_USER=
HZENSE_DATABASE_EXPECTED_POSTGRES_MAJOR=18
HZENSE_DATABASE_EXPECTED_PGVECTOR_VERSION=0.8.6
HZENSE_TOPIC_SYNC_DATABASE_URL=
HZENSE_TOPIC_SYNC_EXPECTED_HOST=
HZENSE_TOPIC_SYNC_EXPECTED_PORT=5432
HZENSE_TOPIC_SYNC_EXPECTED_NAME=
HZENSE_TOPIC_SYNC_EXPECTED_USER=
HZENSE_TOPIC_SYNC_EXPECTED_POSTGRES_MAJOR=18
HZENSE_TOPIC_SYNC_EXPECTED_CONNECTION_LIMIT=2
HZENSE_TOPIC_SYNC_EXPECTED_FINGERPRINT=
HZENSE_TOPIC_SYNC_EXPECTED_PLAN_FINGERPRINT=
HZENSE_TOPIC_SYNC_BACKUP_ID=
HZENSE_SEARCH_SYNC_DATABASE_URL=
HZENSE_SEARCH_SYNC_EXPECTED_FINGERPRINT=
HZENSE_SEARCH_SYNC_EXPECTED_PLAN_FINGERPRINT=
HZENSE_SEARCH_SYNC_BACKUP_ID=
HZENSE_SEARCH_MODE=in-process
HZENSE_RUNTIME_DATABASE_URL=
HZENSE_RUNTIME_EXPECTED_HOST=
HZENSE_RUNTIME_EXPECTED_PORT=5432
HZENSE_RUNTIME_EXPECTED_NAME=
HZENSE_RUNTIME_EXPECTED_USER=
HZENSE_RUNTIME_EXPECTED_POSTGRES_MAJOR=18
HZENSE_RUNTIME_EXPECTED_CONNECTION_LIMIT=20
OPENAI_API_KEY=
AUTH_SECRET=
# Admin Google OAuth. Server-only; configure Production only on Vercel.
# Production NEXTAUTH_URL must be https://hzense.com. Preview login is disabled.
# HZENSE_ADMIN_EMAIL is one authorized Gmail address, never a public variable.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
HZENSE_ADMIN_EMAIL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# 通用材料登记与人工确认（Production 单独配置，默认关闭）
HZENSE_MATERIAL_REGISTRATION_ENABLED=0
HZENSE_MATERIAL_REVIEW_ENABLED=0
HZENSE_MATERIAL_REGISTRAR_DATABASE_URL=
HZENSE_MATERIAL_VERIFIER_DATABASE_URL=
HZENSE_MATERIAL_TRUSTED_VERIFIERS=
HZENSE_MATERIAL_WORKER_TOKEN=
# 仅当前仓库 Actions write；用于确认后提交固定核验工作流
HZENSE_MATERIAL_DISPATCH_TOKEN=
# 签名私钥仅保存在独立 GitHub material-verification 环境，不放入 Vercel。
# 四项信息人工确认发布（需独立 0025 迁移与最小 ACL，默认关闭）
HZENSE_EDITORIAL_PUBLICATION_ENABLED=0
# 分别使用 hzense_editorial_writer / hzense_editorial_reader，sslmode=verify-full。
# 密码仅保存在对应环境的 Secret，不填写到本示例或 NEXT_PUBLIC_*。
HZENSE_EDITORIAL_DATABASE_URL=
HZENSE_EDITORIAL_READER_DATABASE_URL=
