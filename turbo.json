{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["content/**", "data/seed/**", "data/taxonomy/**"],
  "globalEnv": ["HZENSE_SIGNAL_READ_MODE", "HZENSE_EDITORIAL_PUBLICATION_ENABLED"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", ".generation-worker/**"]
    },
    "@hzense/ingestion#build": { "dependsOn": ["^build"], "outputs": [] },
    "lint": { "dependsOn": ["^lint"] },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "test": { "dependsOn": ["^build"], "outputs": ["coverage/**"] },
    "@hzense/ingestion#test": { "dependsOn": ["^build"], "outputs": [] }
  }
}
