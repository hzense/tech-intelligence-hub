{
  "name": "@hzense/database",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run --passWithNoTests",
    "test:migrations": "node test/require-integration-env.mjs && vitest run test/migration.integration.test.mjs",
    "db:migrate": "node src/migrate.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
}
